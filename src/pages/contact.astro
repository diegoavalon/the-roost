---
import Layout from "../layouts/Layout.astro";
import { TRACKS } from "../constants/navigation";

// Turnstile site key - replace with your key from Cloudflare dashboard
const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";

const programFocus = [
  ...TRACKS.map((track) => ({
    value: track.href.split("/").pop()!,
    label: track.label,
    description: track.description ?? "",
  })),
  { value: "unsure", label: "Not sure yet", description: "I need guidance" },
];

const referralSources = [
  { value: "", label: "Select an option" },
  { value: "community-partner", label: "Community Partner" },
  { value: "friend-family", label: "Friend / Family" },
  { value: "social-media", label: "Social Media" },
  { value: "online-search", label: "Online Search" },
  { value: "other", label: "Other" },
];

const inputClasses =
  "w-full px-4 py-3 bg-light/50 border border-dark/20 rounded-sm text-base placeholder:text-dark/40 focus:outline-none focus:border-dark transition-colors";
const labelClasses =
  "block text-xs uppercase tracking-wider font-semibold mb-2";
const selectClasses =
  "w-full px-4 py-3 bg-light/50 border border-dark/20 rounded-sm text-base text-dark/60 focus:outline-none focus:border-dark cursor-pointer appearance-none transition-colors";
---

<Layout title="Contact" bodyClass="dark-nav">
  <main class="min-h-screen bg-orange">
    <!-- Header Section -->
    <section class="pt-section pb-12 px-container-m text-center">
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-green"></span>
        <span class="text-xs uppercase tracking-widest font-semibold"
          >Contact</span
        >
      </div>
      <h1 class="display max-w-[14em] mx-auto mb-2">Ready to Close the Gap?</h1>
      <p class="max-w-[36em] mx-auto text-dark/80 mb-2">
        From where you are to where you're capable of being. Let's start the
        conversation.
      </p>
    </section>

    <!-- Form Section -->
    <section class="pb-section px-container-m">
      <div class="max-w-[42em] mx-auto">
        <form
          x-data="contactForm"
          x-on:submit.prevent="submit()"
          class="bg-light rounded-lg p-10 max-sm:p-6"
          novalidate
        >
          <!-- Full Name -->
          <div class="mb-6">
            <label for="name" class={labelClasses}>
              Full Name <span class="text-maroonred">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              x-ref="name"
              placeholder="Your full name"
              required
              minlength="2"
              maxlength="100"
              class={inputClasses}
              x-bind:class="errors.name && '!border-maroonred'"
              x-on:input="delete errors.name"
            />
            <p
              x-show="errors.name"
              x-text="errors.name"
              class="text-xs text-maroonred mt-1"
            >
            </p>
          </div>

          <!-- Email + Phone Row -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="email" class={labelClasses}>
                Email Address <span class="text-maroonred">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                x-ref="email"
                placeholder="your@email.com"
                required
                class={inputClasses}
                x-bind:class="errors.email && '!border-maroonred'"
                x-on:input="delete errors.email"
              />
              <p
                x-show="errors.email"
                x-text="errors.email"
                class="text-xs text-maroonred mt-1"
              >
              </p>
            </div>
            <div>
              <label for="phone" class={labelClasses}>
                Phone Number <span class="text-dark/40 font-normal normal-case"
                  >(recommended)</span
                >
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                x-ref="phone"
                placeholder="(555) 123-4567"
                maxlength="14"
                class={inputClasses}
                x-bind:class="errors.phone && '!border-maroonred'"
                x-on:input="formatPhone($event)"
              />
              <p
                x-show="errors.phone"
                x-text="errors.phone"
                class="text-xs text-maroonred mt-1"
              >
              </p>
            </div>
          </div>

          <!-- Age -->
          <div class="mb-8">
            <label for="age" class={labelClasses}>
              Age of Participant <span class="text-maroonred">*</span>
            </label>
            <input
              type="number"
              id="age"
              name="age"
              x-ref="age"
              placeholder="Age"
              min="5"
              max="99"
              required
              class={`${inputClasses} max-w-[8em]`}
              x-bind:class="errors.age && '!border-maroonred'"
              x-on:input="clampAge($event)"
            />
            <p
              x-show="errors.age"
              x-text="errors.age"
              class="text-xs text-maroonred mt-1"
            >
            </p>
          </div>

          <!-- Divider -->
          <hr class="border-dark/10 mb-8" />

          <!-- Find Your Why (Program Focus) -->
          <fieldset class="mb-8">
            <legend class={`${labelClasses} mb-1`}>
              Step 1: Find Your Why <span class="text-maroonred">*</span>
            </legend>
            <p class="text-sm text-dark/60 mb-4">
              I'm interested in closing my gap primarily through:
            </p>
            <div class="space-y-3">
              {
                programFocus.map((program) => (
                  <label class="flex items-start gap-3 cursor-pointer group">
                    <input
                      type="checkbox"
                      name="program_focus"
                      value={program.value}
                      class="accent-darkblue mt-1 w-4 h-4 rounded-sm border-dark/30 text-dark focus:ring-dark/20 cursor-pointer"
                      x-on:change="delete errors.program_focus"
                    />
                    <span class="flex-1">
                      <span class="font-semibold text-dark group-hover:text-dark/80 transition-colors">
                        {program.label}
                      </span>
                      <span class="text-dark/60 ml-1">
                        — {program.description}
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p
              x-show="errors.program_focus"
              x-text="errors.program_focus"
              class="text-xs text-maroonred mt-2"
            >
            </p>
          </fieldset>

          <!-- Define Your What (Goal) -->
          <div class="mb-8">
            <label for="goal" class={`${labelClasses} mb-1`}>
              Step 2: Define Your What <span class="text-maroonred">*</span>
            </label>
            <p class="text-sm text-dark/60 mb-4">
              Tell us about your gap. What is the one big, measurable thing you
              want to achieve?
            </p>
            <textarea
              id="goal"
              name="goal"
              x-ref="goal"
              placeholder="I want to be alive to walk my daughter down the aisle."
              rows="3"
              required
              minlength="10"
              maxlength="1000"
              class={`${inputClasses} resize-none`}
              x-bind:class="errors.goal && '!border-maroonred'"
              x-on:input="delete errors.goal"></textarea>
            <p class="text-xs text-dark/40 mt-2 italic">
              Examples: I want to feel strong again; I want my son to gain
              confidence; I want to go to West Texas A&M; I want to lose 30
              pounds.
            </p>
            <p
              x-show="errors.goal"
              x-text="errors.goal"
              class="text-xs text-maroonred mt-1"
            >
            </p>
          </div>

          <!-- Divider -->
          <hr class="border-dark/10 mb-8" />

          <!-- How did you hear about us -->
          <div class="mb-10">
            <label for="referral" class={labelClasses}>
              How did you hear about The Roost?
            </label>
            <select
              id="referral"
              name="referral"
              class={selectClasses}
              style="background-image: url('data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23666%22 stroke-width=%222%22%3E%3Cpath d=%22M6 9l6 6 6-6%22/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 1rem center;"
            >
              {
                referralSources.map((source) => (
                  <option value={source.value}>{source.label}</option>
                ))
              }
            </select>
          </div>

          <!-- Turnstile Widget -->
          <div class="mb-6">
            <div
              class="cf-turnstile"
              data-sitekey={TURNSTILE_SITE_KEY}
              data-theme="light"
            >
            </div>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            x-bind:disabled="submitting"
            class="inline-flex items-center gap-2 py-4 px-8 bg-dark text-light text-sm font-bold uppercase tracking-wider rounded-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0 disabled:opacity-60 disabled:cursor-not-allowed disabled:translate-y-0 disabled:shadow-none"
          >
            <span x-text="buttonLabel">Start My Transformation</span>
            <svg
              class="w-4 h-4 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<!-- Cloudflare Turnstile -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  import { isValidPhoneNumber } from "libphonenumber-js";

  declare global {
    interface Window {
      Alpine: typeof import("alpinejs").default;
      turnstile?: {
        reset: (container?: string | HTMLElement) => void;
      };
    }
  }

  document.addEventListener("alpine:init", () => {
    window.Alpine.data("contactForm", () => ({
      errors: {} as Record<string, string>,
      submitting: false,
      buttonLabel: "Start My Transformation",

      formatPhone(event: InputEvent) {
        const input = event.target as HTMLInputElement;
        const cursorPos = input.selectionStart || 0;
        const oldLength = input.value.length;
        const digits = input.value.replace(/\D/g, "").slice(0, 10);
        if (digits.length === 0) input.value = "";
        else if (digits.length <= 3) input.value = `(${digits}`;
        else if (digits.length <= 6)
          input.value = `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
        else
          input.value = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
        const diff = input.value.length - oldLength;
        input.setSelectionRange(cursorPos + diff, cursorPos + diff);
        delete this.errors.phone;
      },

      clampAge(event: InputEvent) {
        const input = event.target as HTMLInputElement;
        if (input.value.length > 2) input.value = input.value.slice(0, 2);
        delete this.errors.age;
      },

      validate(): boolean {
        this.errors = {};
        const $refs = (this as any).$refs;
        const $el = (this as any).$el as HTMLFormElement;

        const name = ($refs.name as HTMLInputElement).value.trim();
        if (!name || name.length < 2)
          this.errors.name =
            "Please enter your full name (at least 2 characters)";

        const email = ($refs.email as HTMLInputElement).value;
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
          this.errors.email = "Please enter a valid email address";

        const phone = ($refs.phone as HTMLInputElement).value;
        if (phone && !isValidPhoneNumber(phone, "US"))
          this.errors.phone = "Please enter a valid US phone number";

        const age = parseInt(($refs.age as HTMLInputElement).value, 10);
        if (isNaN(age) || age < 5 || age > 99)
          this.errors.age = "Please enter an age between 5 and 99";

        const checked = $el.querySelectorAll(
          'input[name="program_focus"]:checked',
        );
        if (checked.length === 0)
          this.errors.program_focus = "Please select at least one program";

        const goal = ($refs.goal as HTMLTextAreaElement).value.trim();
        if (!goal || goal.length < 10)
          this.errors.goal =
            "Please describe your goal (at least 10 characters)";

        return Object.keys(this.errors).length === 0;
      },

      async submit() {
        if (!this.validate()) return;

        const form = (this as any).$el as HTMLFormElement;
        const formData = new FormData(form);

        const turnstileResponse = formData.get("cf-turnstile-response");
        if (!turnstileResponse) {
          alert("Please complete the security check");
          return;
        }

        const programFocus = formData.getAll("program_focus");
        const data: Record<string, unknown> = {};
        formData.forEach((value, key) => {
          if (key !== "program_focus") data[key] = value;
        });
        data.program_focus = programFocus;

        this.submitting = true;
        this.buttonLabel = "Sending...";

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });

          const result = (await response.json()) as { error?: string };

          if (response.ok) {
            this.buttonLabel = "Message Sent!";
            form.reset();
            if (window.turnstile) window.turnstile.reset();
            setTimeout(() => {
              this.submitting = false;
              this.buttonLabel = "Start My Transformation";
            }, 3000);
          } else {
            throw new Error(result.error || "Failed to send");
          }
        } catch (err) {
          console.error("Submission error:", err);
          this.buttonLabel = "Error — Try Again";
          if (window.turnstile) window.turnstile.reset();
          setTimeout(() => {
            this.submitting = false;
            this.buttonLabel = "Start My Transformation";
          }, 3000);
        }
      },
    }));
  });
</script>
