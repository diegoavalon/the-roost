---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import News from "../components/News.astro";

import theNutrientsImg from "../assets/images/the-nutrients.jpg";
import theStudyImg from "../assets/images/the-books.png";
import theGymImg from "../assets/images/the-gym.jpg";
import heroPosterImg from "../assets/videos/hero-poster.jpg";
---

<Layout
  title="The Roost — A community development program in Donley County, TX"
>
  <Hero poster={[theStudyImg, theGymImg, heroPosterImg, theNutrientsImg]}>
    <h1 class="flex items-center text-center display m-0 text-light">
      <div>
        <span class="display-bold">Your life has</span>
        <span class="relative inline-block">
          <span class="display-italic">more</span>
          <svg
            class="absolute -bottom-[0.1em] left-0 w-full h-[0.15em] text-light opacity-60"
            viewBox="0 0 400 20"
            preserveAspectRatio="none"
          >
            <path
              d="M0 10 Q50 0, 100 10 T200 10 T300 10 T400 10"
              stroke="currentColor"
              stroke-width="2"
              fill="none"></path>
          </svg>
        </span>
        <span class="display-bold"> in it.</span>
      </div>
    </h1>
  </Hero>
  <News />
</Layout>
