---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import homePosterImg from "../assets/videos/home-poster.jpg";
import homeVideoMp4 from "../assets/videos/home-optimized.mp4";
import homeVideoWebm from "../assets/videos/home-optimized.webm";
---

<Layout
  title="The Roost — A community development program in Donley County, TX"
  bodyClass="overflow-hidden"
>
  <Hero
    poster={homePosterImg}
    videoWebm={homeVideoWebm}
    videoMp4={homeVideoMp4}
  >
    <h1 class="flex items-center text-center display m-0 text-light">
      <div>
        <span class="display-bold">Your kid has</span>
        <span class="relative inline-block">
          <span class="display-italic">more</span>
          <svg
            class="absolute -bottom-[0.1em] left-0 w-full h-[0.15em] text-light opacity-60"
            viewBox="0 0 400 20"
            preserveAspectRatio="none"
          >
            <path
              d="M0 10 Q50 0, 100 10 T200 10 T300 10 T400 10"
              stroke="currentColor"
              stroke-width="2"
              fill="none"></path>
          </svg>
        </span>
        <span class="display-bold"> in them.</span>
      </div>
    </h1>
  </Hero>
</Layout>
