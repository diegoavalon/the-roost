---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  poster: ImageMetadata[] | ImageMetadata;
  videoWebm?: string;
  videoMp4?: string;
  playbackRate?: number;
}

const { poster, videoWebm, videoMp4, playbackRate = 0.75 } = Astro.props;

const hasVideo = videoWebm || videoMp4;
const posters = Array.isArray(poster) ? poster : [poster];
const isCarousel = !hasVideo && posters.length > 1;
---

<section class="relative w-full h-screen min-h-[600px] overflow-hidden bg-dark">
  <!-- Video/Image Background -->
  <div class="absolute inset-0 z-0">
    {
      hasVideo ? (
        <video
          id="hero-video"
          class="w-full h-full object-cover"
          autoplay
          muted
          loop
          playsinline
          poster={posters[0].src}
          data-playback-rate={playbackRate}
        >
          {videoWebm && <source src={videoWebm} type="video/webm" />}
          {videoMp4 && <source src={videoMp4} type="video/mp4" />}
        </video>
      ) : isCarousel ? (
        posters.map((img, i) => (
          <Image
            src={img}
            alt=""
            class={`hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1500 ease-in-out ${i === 0 ? "opacity-100" : "opacity-0"}`}
            data-index={i}
          />
        ))
      ) : (
        <Image src={posters[0]} alt="" class="w-full h-full object-cover" />
      )
    }
  </div>

  <!-- Overlay -->
  <div
    class="absolute inset-0 z-1 bg-radial-[ellipse_at_center] from-transparent via-dark/30 to-dark/80"
    aria-hidden="true"
  >
  </div>

  <!-- Hero Content -->
  <div
    class="absolute inset-0 z-[5] flex items-end justify-center p-container-m pb-[calc(var(--spacing-container-m)+4em)]"
  >
    <slot />
  </div>
</section>

<script>
  // Video playback rate
  const video = document.getElementById("hero-video") as HTMLVideoElement;
  if (video) {
    const rate = parseFloat(video.dataset.playbackRate || "0.75");
    video.playbackRate = rate;
  }

  // Crossfade carousel
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
  if (slides.length > 1) {
    let current = 0;
    const DISPLAY_MS = 5000;

    setInterval(() => {
      slides[current].classList.replace("opacity-100", "opacity-0");
      current = (current + 1) % slides.length;
      slides[current].classList.replace("opacity-0", "opacity-100");
    }, DISPLAY_MS);
  }
</script>
