<style>
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--spacing-container-m);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25em;
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xl);
    color: var(--color-light);
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-light);
    text-decoration: none;
    letter-spacing: var(--tracking-display);
  }

  .nav-icon {
    width: 1.5em;
    height: 1.5em;
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .dropdown-arrow {
    transition: transform 0.2s ease;
  }

  .dropdown:hover .dropdown-arrow,
  .dropdown.is-open .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-content {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    background: var(--color-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    min-width: 32rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }

  .dropdown:hover .dropdown-content,
  .dropdown.is-open .dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-label {
    display: block;
    font-size: 0.875rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-orange);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .dropdown-list {
    display: flex;
    flex-direction: column;
  }

  .dropdown-item {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-dark);
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }

  .dropdown-item:hover {
    color: var(--color-orange);
  }

  /* Preview panel */
  .dropdown-preview {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    min-height: 12rem;
  }

  .preview-image {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .preview-image:first-child,
  .preview-image.active {
    opacity: 1;
  }

  .preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: var(--color-light);
  }

  .preview-name {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
  }

  .preview-desc {
    display: block;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  /* Hamburger button */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25em;
    width: 2em;
    height: 2em;
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-light);
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
    transform-origin: center;
  }

  .nav-hamburger.is-open span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-hamburger.is-open span:nth-child(2) {
    opacity: 0;
  }

  .nav-hamburger.is-open span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--color-dark);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spacing-container-m);
  }

  .mobile-menu-close {
    align-self: flex-end;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-light);
    padding: 0.25em;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .mobile-menu-close:hover {
    opacity: 1;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    gap: 0;
  }

  .mobile-menu-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-orange);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .mobile-menu-item {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 900;
    color: var(--color-light);
    text-decoration: none;
    line-height: 1.1;
    padding: 0.2em 0;
    transition: color 0.2s ease;
  }

  .mobile-menu-item:hover {
    color: var(--color-orange);
  }

  .mobile-menu-divider {
    border: none;
    border-top: 1px solid rgba(240, 235, 230, 0.15);
    margin: 2rem 0;
  }

  .mobile-menu-contact {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-light);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .mobile-menu-contact:hover {
    opacity: 1;
  }

  /* Responsive: show hamburger, hide desktop items */
  @media (max-width: 767px) {
    .nav {
      align-items: center;
      padding: 0.5rem 1rem;
    }
    .nav-logo svg {
      width: 112px;
    }
    .mobile-menu-close {
      position: absolute;
      top: 1.675rem;
      right: 1rem;
    }
    .dropdown,
    .nav-contact {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }
  }
</style>

<script>
  // ── Dropdown: preview image on hover ──
  const dropdownItems = document.querySelectorAll(".dropdown-item");
  const previewImages = document.querySelectorAll(".preview-image");

  dropdownItems.forEach((item) => {
    item.addEventListener("mouseenter", () => {
      const index = item.getAttribute("data-index");
      previewImages.forEach((img) => img.classList.remove("active"));
      const target = document.querySelector(`[data-preview="${index}"]`);
      if (target) target.classList.add("active");
    });
  });

  // ── Dropdown: touch support ──
  const dropdown = document.querySelector(".dropdown") as HTMLElement | null;
  const dropdownTrigger = document.querySelector(
    ".dropdown-trigger",
  ) as HTMLButtonElement | null;

  dropdownTrigger?.addEventListener(
    "touchstart",
    (e) => {
      e.preventDefault();
      const isOpen = dropdown?.classList.toggle("is-open");
      if (dropdownTrigger) {
        dropdownTrigger.setAttribute("aria-expanded", String(isOpen));
      }
    },
    { passive: false },
  );

  document.addEventListener(
    "touchstart",
    (e) => {
      if (dropdown && !dropdown.contains(e.target as Node)) {
        dropdown.classList.remove("is-open");
        dropdownTrigger?.setAttribute("aria-expanded", "false");
      }
    },
    { passive: true },
  );

  // ── Mobile menu ──
  const hamburger = document.getElementById(
    "nav-hamburger",
  ) as HTMLButtonElement | null;
  const mobileMenu = document.getElementById(
    "mobile-menu",
  ) as HTMLElement | null;
  const mobileClose = document.getElementById(
    "mobile-menu-close",
  ) as HTMLButtonElement | null;

  function openMenu() {
    mobileMenu?.classList.add("is-open");
    mobileMenu?.setAttribute("aria-hidden", "false");
    hamburger?.classList.add("is-open");
    hamburger?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    mobileMenu?.classList.remove("is-open");
    mobileMenu?.setAttribute("aria-hidden", "true");
    hamburger?.classList.remove("is-open");
    hamburger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  hamburger?.addEventListener("click", openMenu);
  mobileClose?.addEventListener("click", closeMenu);

  // Close when a nav link inside the menu is tapped
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
