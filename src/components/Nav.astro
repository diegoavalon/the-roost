---
import { Image } from "astro:assets";
import { TRACKS, CONTACT } from "../constants/navigation";

// Track images
import theNutrientsImg from "../assets/images/the-nutrients.jpg";
import theStudyImg from "../assets/images/the-books.png";
import theGymImg from "../assets/images/the-gym.jpg";
import heroPosterImg from "../assets/videos/hero-poster.jpg";

interface Props {
  contactHref?: string;
}

const { contactHref = CONTACT.whatsapp } = Astro.props;

// Combine track data with images
const trackImages = [heroPosterImg, theGymImg, theNutrientsImg, theStudyImg];
const tracks = TRACKS.map((track, i) => ({ ...track, image: trackImages[i] }));
---

<nav class="nav">
  <!-- Programs dropdown (desktop) -->
  <div class="dropdown">
    <button
      class="nav-link nav-link--work dropdown-trigger"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <span class="font-black">Tracks</span>
      <svg
        class="dropdown-arrow"
        width="24"
        height="24"
        viewBox="0 0 12 12"
        fill="none"
      >
        <path
          d="M3 4.5L6 7.5L9 4.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="dropdown-content">
      <!-- Left: Track list -->
      <div class="dropdown-list">
        <span class="dropdown-label">Tracks</span>
        {
          tracks.map((track, index) => (
            <a href={track.href} class="dropdown-item" data-index={index}>
              {track.label}
            </a>
          ))
        }
      </div>

      <!-- Right: Image preview -->
      <div class="dropdown-preview">
        {
          tracks.map((track, index) => (
            <div class="preview-image" data-preview={index}>
              <Image src={track.image} alt={track.label} class="preview-img" />
              <div class="preview-info">
                <span class="preview-name">{track.label}</span>
                <span class="preview-desc">{track.description}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <a href="/" class="nav-logo text-light">
    <svg
      width="158"
      height="68"
      viewBox="0 0 158 68"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
