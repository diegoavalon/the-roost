---
import { NAV_COLUMNS, CONTACT, type NavColumn } from "../constants/navigation";

interface Props {
  tagline?: string;
  email?: string;
  navColumns?: NavColumn[];
  copyright?: string;
}

const currentYear = new Date().getFullYear();

const {
  tagline = "Forging character through struggle.",
  email = CONTACT.email,
  navColumns = NAV_COLUMNS,
  copyright = `© ${currentYear} The Roost. A nonprofit organization serving Donley County, Texas.`,
} = Astro.props;
---

<footer
  class="bg-light pt-16 pb-8 px-container-m max-sm:pt-12 max-sm:pb-6 max-sm:px-container-s"
>
  <div class="max-w-[--container-lg] mx-auto">
    <!-- Top section -->
    <div
      class="grid grid-cols-[1fr_auto] gap-16 mb-20 max-md:grid-cols-1 max-md:gap-10"
    >
      <!-- Left: Tagline + Contact -->
      <div class="max-w-[28em]">
        <p
          class="text-[clamp(1.5rem,4vw,2rem)] font-bold leading-tight m-0 mb-8"
        >
          {tagline}
        </p>
        <div class="flex items-center">
          <a
            href={`mailto:${email}`}
            class="email-link inline-flex items-center gap-4 text-dark no-underline text-base pb-2 border-b border-dark transition-opacity hover:opacity-70"
          >
            <span class="flex-1">{email}</span>
            <svg
              class="w-6 h-6 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Nav columns -->
      <nav class="flex gap-16 max-md:gap-10 max-sm:flex-col max-sm:gap-6">
        {
          navColumns.map((column) => (
            <div>
              <h4 class="text-sm font-normal uppercase tracking-wide opacity-50 m-0 mb-4">
                {column.title}
              </h4>
              <ul class="list-none p-0 m-0 flex flex-col gap-2">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-dark no-underline font-semibold transition-opacity hover:opacity-70"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <p class="text-sm m-0 text-center mb-4">{copyright}</p>

    <!-- Divider -->
    <hr class="border-0 border-t border-black/10 m-0 mb-6" />

    <!-- Bottom section -->

    <!-- Logo mark -->
    <div class="flex justify-center">
