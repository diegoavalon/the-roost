<section class="intro pt-section pb-container-m">
  <h2 class="display text-center text-black mb-2">
    <div class="hero-headline__line">
      <span class="display-bold">They need </span>
      <span class="relative inline-block">
        <span class="display-italic">a mat</span>
        <svg
          class="absolute -bottom-[0.1em] left-0 w-full h-[0.15em] opacity-60"
          viewBox="0 0 400 20"
          preserveAspectRatio="none"
        >
          <path
            d="M0 10 Q50 0, 100 10 T200 10 T300 10 T400 10"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></path>
        </svg>
      </span>
      <span>.</span>
    </div>
  </h2>
  <div class="px-6 max-w-sm mx-auto mt-6 text-lg text-center">
    <p class="mb-4">
      The Roost is a free, nonprofit wrestling club in <span class="font-black"
        >Howardwick, Texas</span
      >.
    </p>
    <p class="mb-12">
      We teach discipline, toughness, and respect to kids, teens, and adults —
      no fees, no tryouts, no experience required.
    </p>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400">
      <defs>
        <filter id="dropShadow" x="-10%" y="-10%" width="120%" height="120%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="5"></feGaussianBlur>
          <feOffset dx="0" dy="5" result="offsetblur"></feOffset>
          <feComponentTransfer>
            <feFuncA type="linear" slope="0.5"></feFuncA>
          </feComponentTransfer>
          <feMerge>
            <feMergeNode></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <g filter="url(#dropShadow)">
        <path
          d="M100 300 L700 300 L550 50 L250 50 Z"
          fill="#FFD700"
          stroke="#FFD700"
          stroke-width="4"></path>
        <path d="M115 290 L685 290 L543 60 L257 60 Z" fill="#224C8B"></path>
      </g>
    </svg>
  </div>
</section>
