---
import "../styles/global.css";
import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  bodyClass?: string;
}

const { title = "Roost", bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Fonts (auto-optimized by Astro) -->
    <Font cssVariable="--astro-font-sans" preload />
    <Font cssVariable="--astro-font-display" preload />
    <Font cssVariable="--astro-font-serif" preload />
  </head>
  <body class={bodyClass}>
    <Nav />

    <slot />

    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
